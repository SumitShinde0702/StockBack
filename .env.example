# StockBack environment template.
# Copy to .env.local (git-ignored) and fill in. Nothing here is required to run the UI in
# preview mode; the onchain path activates once the router addresses are set.

# --- X Layer -----------------------------------------------------------------------
# Official X Layer testnet (chain ID 1952). Chain 195 is deprecated.
# Public RPC. Override if you are rate-limited.
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
NEXT_PUBLIC_XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon

# --- Deployment (packages/contracts) ----------------------------------------------
# Funded X Layer testnet key used only by `pnpm deploy:xlayer`. Use a throwaway wallet.
DEPLOYER_PRIVATE_KEY=
# Receives the 1% protocol reserve. Defaults to the deployer when unset.
TREASURY_ADDRESS=
# Receives the 1% reward funding and is expected to back the reward ledger.
REWARD_FUND_ADDRESS=

# --- Quote signing ----------------------------------------------------------------
# Server-side only. The router verifies quotes against this key's address, so the same
# value must be present when deploying and when running the web app.
QUOTE_SIGNER_PRIVATE_KEY=

# --- Deployed addresses (printed by `pnpm deploy:xlayer`) -------------------------
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_PAY_TOKEN_ADDRESS=
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=

# --- Demo merchant registry -------------------------------------------------------
# Settlement addresses that consented to receive crypto for a PayNow identifier. An SGQR
# payload never contains an EVM address; this mapping is the consent record.
NEXT_PUBLIC_MERCHANT_A=
NEXT_PUBLIC_MERCHANT_B=
NEXT_PUBLIC_MERCHANT_C=

# --- Official xStock references (optional, read-only) -----------------------------
# Set only if you have independently verified an official xStock contract on X Layer.
# Left blank, the app states plainly that the reward token is a labelled mock.
NEXT_PUBLIC_XSTOCK_XNVDA=
NEXT_PUBLIC_XSTOCK_XAAPL=
NEXT_PUBLIC_XSTOCK_XTSLA=
